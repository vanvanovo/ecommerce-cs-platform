# ============ 电商多 Agent 智能客服平台 · 环境变量模板 ============
# 使用：复制为 .env.local 并填写真实值（.env.local 已在 .gitignore 中，绝不入库）

# ---- 基础设施 ----
DB_HOST=localhost
DB_PORT=5433
DB_NAME=edu_agent
DB_USER=<你的 PostgreSQL 用户名>
DB_PASSWORD=<你的 PostgreSQL 密码>
MILVUS_HOST=localhost
MILVUS_PORT=19531
REDIS_URL=redis://localhost:6380/0

# ---- 模型 ----
DEEPSEEK_API_KEY=<你的 DeepSeek Key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_CHAT=deepseek-chat

# ---- 意图路由（本地 Qwen 优先 + 云端回退）----
ROUTER_PROVIDER=ollama_cpu
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_ROUTER_MODEL=qwen2.5:7b
DASHSCOPE_API_KEY=<可选：qwen-flash 回退通道>
QWEN_ROUTER_MODEL=qwen-flash

# ---- MCP 服务间鉴权 ----
MCP_API_KEY=<服务间共享 Key>

# ---- 业务开关 ----
ORDER_BACKEND=db
ORDER_API_BASE=http://localhost:8200
RAG_VIA_A2A=false
RAG_AGENT_URL=http://localhost:5008
RAG_AGENT_RETRIEVAL_MODE=mcp

# ---- 安全 ----
JWT_SECRET_KEY=<随机字符串>

# ---- 应用 ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
